---
// src/components/ShelfCover.astro
// 实体封面组件：支持实图封面、莫兰迪精装书排版封面、学术论文抽印本封面
import { Image } from 'astro:assets';
import type { ShelfItem } from '../utils/posts';

interface Props {
  item: ShelfItem;
  size?: 'shelf' | 'modal';
}

const { item, size = 'shelf' } = Astro.props;
const isPaper = item.type === 'paper';
---

<div
  class:list={[
    'shelf-cover-art',
    item.cover ? 'is-photo' : isPaper ? 'is-editorial-paper' : 'is-editorial-book',
    item.cover && isPaper && 'is-paper-page',
    size === 'modal' && 'is-modal-art',
  ]}
  style={`--cover-bg:${item.palette.coverBg};--cover-fg:${item.palette.coverFg};--cover-muted:${item.palette.coverMuted};--cover-band:${item.palette.band};--cover-band-fg:${item.palette.bandFg};--cover-accent:${item.palette.accent};`}
>
  {item.cover ? (
    <>
      <Image
        src={item.cover}
        alt={item.spineTitle}
        width={size === 'modal' ? 960 : 720}
        loading="eager"
        decoding="async"
        class:list={['shelf-cover-photo', isPaper && 'is-paper-sheet']}
      />
      {isPaper && <span class="paper-staple" aria-hidden="true"></span>}
    </>
  ) : isPaper ? (
    <div class="editorial-paper">
      <div class="editorial-paper-top">
        <span class="editorial-paper-badge">PAPER · {item.numberLabel}</span>
        <span class="editorial-paper-year">{item.year}</span>
      </div>
      <div class="editorial-paper-rule" aria-hidden="true"></div>
      <div class="editorial-paper-body">
        <p class="editorial-paper-kicker">PAPER NOTE · {item.group.toUpperCase()}</p>
        <p class="editorial-paper-title">{item.spineTitle}</p>
        {item.description && <p class="editorial-paper-abstract">{item.description}</p>}
      </div>
      <div class="editorial-paper-motif" aria-hidden="true">
        <svg viewBox="0 0 200 54" fill="none">
          <line x1="0" y1="27" x2="200" y2="27" stroke="currentColor" stroke-opacity="0.22" stroke-width="1" />
          <path
            d="M8 42 C 36 8, 66 8, 96 27 S 158 46, 192 12"
            stroke="currentColor"
            stroke-opacity="0.52"
            stroke-width="1.35"
          />
          <circle cx="52" cy="17" r="3" fill="currentColor" fill-opacity="0.65" />
          <circle cx="96" cy="27" r="3" fill="currentColor" fill-opacity="0.65" />
          <circle cx="144" cy="37" r="3" fill="currentColor" fill-opacity="0.65" />
        </svg>
      </div>
      <div class="editorial-paper-foot">
        <span class="editorial-paper-author">{item.author}</span>
      </div>
    </div>
  ) : (
    <div class="editorial-book">
      <div class="editorial-book-band">
        <span class="editorial-book-num">{item.numberLabel}</span>
        <span class="editorial-book-group">{item.group}</span>
      </div>
      <div class="editorial-book-body">
        <p class="editorial-book-title">{item.spineTitle}</p>
      </div>
      <div class="editorial-book-motif" aria-hidden="true">
        <svg viewBox="0 0 200 72" fill="none">
          <circle cx="62" cy="36" r="24" stroke="currentColor" stroke-opacity="0.28" stroke-width="1.2" />
          <circle cx="100" cy="36" r="24" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.2" />
          <circle cx="138" cy="36" r="24" stroke="currentColor" stroke-opacity="0.28" stroke-width="1.2" />
          <line x1="18" y1="36" x2="182" y2="36" stroke="currentColor" stroke-opacity="0.18" stroke-width="1" />
        </svg>
      </div>
      <div class="editorial-book-foot">
        <span class="editorial-book-author">{item.author}</span>
        <span class="editorial-book-year">{item.year}</span>
      </div>
    </div>
  )}
</div>
