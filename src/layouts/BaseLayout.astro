---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pageName?: string;
  activeNav?: 'home' | 'blog' | 'products';
}

const {
  title = "文档 | f10w-0x00",
  description = "f10w-0x00 的个人博客，收录学习、技术与日常的观察和记录。",
  pageName = "blog-index",
  activeNav = "blog"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN" data-page={pageName} data-storage-namespace="KenShelter" data-storage-legacy-namespaces="[&quot;ken-blog&quot;]" data-visitor-enabled="true">
  <head>
    <script is:inline>

      (() => {
        let theme = null;
        let fontSize = null;
        let contentWidth = null;
        let externalLinkIcons = null;
        let commentsDisplay = null;
        let commentSidePreview = null;
        let visitorIdentityPanels = null;

        try {
          const storageNamespace =
            document.documentElement.dataset.storageNamespace || "ExampleSite";
          const visitorEnabled =
            document.documentElement.dataset.visitorEnabled === "true";
          const legacyStorageNamespaces = (() => {
            try {
              const parsed = JSON.parse(
                document.documentElement.dataset.storageLegacyNamespaces || "[]"
              );

              if (Array.isArray(parsed) && parsed.every((value) => typeof value === "string" && value)) {
                return [...new Set(parsed)].filter((value) => value !== storageNamespace);
              }
            } catch {
              // 配置属性异常时忽略旧键，避免共享主题猜测实例的历史命名空间。
            }

            return [];
          })();

          // 读取当前命名空间，并把所有旧命名空间中的首个已有值原样搬迁。
          const readMigratedPreference = (preferenceName) => {
            const currentKey = `${storageNamespace}-${preferenceName}`;
            const legacyKeys = legacyStorageNamespaces.map(
              (namespace) => `${namespace}-${preferenceName}`
            );
            const currentValue = window.localStorage?.getItem(currentKey);
            const legacyValue =
              currentValue === null
                ? legacyKeys
                    .map((legacyKey) => window.localStorage?.getItem(legacyKey))
                    .find((value) => value !== null) ?? null
                : null;

            try {
              if (legacyValue !== null) {
                window.localStorage?.setItem(currentKey, legacyValue);
              }
              legacyKeys.forEach((legacyKey) => window.localStorage?.removeItem(legacyKey));
            } catch {
              // 写入受限时仍使用刚读到的旧值渲染首帧，后续页面可继续尝试搬迁。
            }

            return currentValue ?? legacyValue;
          };

          theme = readMigratedPreference("theme");
          fontSize = readMigratedPreference("font-size");
          contentWidth = readMigratedPreference("content-width");
          externalLinkIcons = readMigratedPreference("external-link-icons");
          if (visitorEnabled) {
            commentsDisplay = readMigratedPreference("comments-display");
            commentSidePreview = readMigratedPreference("comment-side-preview");
            visitorIdentityPanels = readMigratedPreference("visitor-identity-panels");
          }
        } catch {
          theme = null;
          fontSize = null;
          contentWidth = null;
          externalLinkIcons = null;
          commentsDisplay = null;
          commentSidePreview = null;
          visitorIdentityPanels = null;
        }

        const themeMode = theme === "light" || theme === "dark" ? theme : "auto";
        const readingFontSize = fontSize === "s" || fontSize === "l" ? fontSize : "m";
        const readingWidth = contentWidth === "s" || contentWidth === "l" ? contentWidth : "m";
        const externalLinkIconMode = externalLinkIcons === "off" ? "off" : "on";
        const visitorEnabled =
          document.documentElement.dataset.visitorEnabled === "true";

        // 提前同步用户偏好，避免页面切换时设置控件和正文尺寸先显示默认值。
        document.documentElement.dataset.themeMode = themeMode;
        document.documentElement.dataset.fontSize = readingFontSize;
        document.documentElement.dataset.contentWidth = readingWidth;
        document.documentElement.dataset.externalLinkIcons = externalLinkIconMode;
        if (visitorEnabled) {
          document.documentElement.dataset.commentsDisplay =
            commentsDisplay === "off" ? "off" : "on";
          document.documentElement.dataset.commentSidePreview =
            commentSidePreview === "on" ? "on" : "off";
        }

        // 访客身份页在首帧绘制前恢复面板状态，避免客户端脚本加载前短暂显示展开内容。
        if (
          visitorEnabled &&
          document.documentElement.dataset.page === "visitor-identity"
        ) {
          document.documentElement.dataset.visitorIdentityPanels =
            visitorIdentityPanels === "collapsed" ? "collapsed" : "expanded";
        }

        if (themeMode === "light" || themeMode === "dark") {
          document.documentElement.dataset.theme = themeMode;
        }
      })();
    
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content="Astro v6.4.8" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="alternate" href="/rss.xml" type="application/rss+xml" title="Ken’s Shelter RSS" />
    <link rel="stylesheet" href="/_astro/BaseLayout.BXLOwkA9.css" />
  </head>
