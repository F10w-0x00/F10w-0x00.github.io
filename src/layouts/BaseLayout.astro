---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pageName?: string;
  activeNav?: 'home' | 'blog' | 'products';
}

const {
  title = "文档 | f10w-0x00",
  description = "f10w-0x00 的个人博客，收录学习、技术与日常的观察和记录。",
  pageName = "blog-index",
  activeNav = "blog"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN" data-page={pageName} data-storage-namespace="KenShelter" data-storage-legacy-namespaces="[&quot;ken-blog&quot;]" data-visitor-enabled="false">
  <head>
    <script is:inline>
      (() => {
        let theme = null;
        let fontSize = null;
        let contentWidth = null;

        try {
          const storageNamespace = document.documentElement.dataset.storageNamespace || "KenShelter";
          theme = window.localStorage?.getItem(`${storageNamespace}-theme`);
          fontSize = window.localStorage?.getItem(`${storageNamespace}-font-size`);
          contentWidth = window.localStorage?.getItem(`${storageNamespace}-content-width`);
        } catch {}

        const themeMode = theme === "light" || theme === "dark" ? theme : "auto";
        const readingFontSize = fontSize === "s" || fontSize === "l" ? fontSize : "m";
        const readingWidth = contentWidth === "s" || contentWidth === "l" ? contentWidth : "m";

        document.documentElement.dataset.themeMode = themeMode;
        document.documentElement.dataset.fontSize = readingFontSize;
        document.documentElement.dataset.contentWidth = readingWidth;
        document.documentElement.dataset.externalLinkIcons = "on";

        if (themeMode === "light" || themeMode === "dark") {
          document.documentElement.dataset.theme = themeMode;
        }
      })();

      // 已读博文（Visited Checkmark）核心交互逻辑
      (() => {
        const visitedPostsKey = 'KenShelter-visited-posts';
        function getVisitedSet() {
          try {
            return new Set(JSON.parse(localStorage.getItem(visitedPostsKey) || '[]'));
          } catch {
            return new Set();
          }
        }
        function saveVisited(slug) {
          if (!slug) return;
          try {
            const visited = getVisitedSet();
            visited.add(slug);
            localStorage.setItem(visitedPostsKey, JSON.stringify([...visited]));
          } catch {}
        }
        function updateVisitedMarks() {
          const visited = getVisitedSet();
          document.querySelectorAll('[data-reading-post-slug]').forEach((card) => {
            const slug = card.getAttribute('data-reading-post-slug');
            const icon = card.querySelector('[data-post-visited-icon]');
            if (slug && icon) {
              icon.classList.toggle('is-visited', visited.has(slug));
            }
          });
        }

        // 页面就绪后标记打勾
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', updateVisitedMarks, { once: true });
        } else {
          updateVisitedMarks();
        }
        document.addEventListener('astro:page-load', updateVisitedMarks);

        // 如果在文章页面，将当前文章自动记为已读
        document.addEventListener('DOMContentLoaded', () => {
          const readingElem = document.querySelector('[data-post-reading]');
          if (readingElem) {
            const currentSlug = readingElem.getAttribute('data-reading-post-slug');
            if (currentSlug) {
              saveVisited(currentSlug);
            }
          }
        });

        // 监听卡片点击立即打勾
        document.addEventListener('click', (e) => {
          const link = e.target.closest('a[href*="/blog/20"]');
          const card = link ? link.closest('[data-reading-post-slug]') : null;
          if (card) {
            const slug = card.getAttribute('data-reading-post-slug');
            if (slug) {
              saveVisited(slug);
              const icon = card.querySelector('[data-post-visited-icon]');
              if (icon) icon.classList.add('is-visited');
            }
          }
        }, { passive: true });
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content="Astro v6.4.8" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="alternate" href="/rss.xml" type="application/rss+xml" title="f10w-0x00 RSS" />
    <link rel="stylesheet" href="/_astro/BaseLayout.BXLOwkA9.css" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header-inner">
          <a class="brand" href="/" aria-label="f10w-0x00 首页">
            <img class="brand-avatar" src="/avatar.svg" alt="" width="22" height="22" style="border-radius: 4px; vertical-align: -3px; margin-right: 7px; display: inline-block;" />
            f10w-0x00
          </a>
          <nav class="site-nav" aria-label="主导航">
            <a href="/" aria-current={activeNav === 'home' ? 'page' : undefined}> 首页 </a>
            <a href="/blog/" aria-current={activeNav === 'blog' ? 'page' : undefined}> 文档 </a>
          </nav>
          <div class="site-header-actions">
            <!-- 回到跳转前位置 (同页锚点跳转后出现) -->
            <button class="anchor-return-button" type="button" data-anchor-return hidden aria-label="回到跳转前的位置" title="回到跳转前的位置">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="M9.25 5.75 4.75 10.25l4.5 4.5"></path>
                <path d="M5.25 10.25h8.8a5.2 5.2 0 0 1 5.2 5.2v2.8"></path>
              </svg>
            </button>

            <!-- 网站设置按钮 -->
            <button class="settings-button" type="button" data-settings-toggle aria-label="打开网站设置" aria-controls="site-settings-panel" aria-expanded="false" title="网站设置">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.52a2 2 0 0 1-1 1.72l-.15.1a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.52a2 2 0 0 1 1-1.72l.15-.1a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>

          <!-- 网站设置浮层抽屉面板 (仅保留有效外观、字号与宽度) -->
          <div class="site-settings-panel" id="site-settings-panel" data-settings-panel role="dialog" aria-label="网站设置" tabindex="-1" hidden>
            <div class="site-settings-header">
              <p class="site-settings-title">设置</p>
            </div>
            <div class="site-settings-list">
              <div class="site-settings-section">
                <!-- 外观设置 -->
                <div class="site-setting-row">
                  <span class="site-setting-label">外观</span>
                  <div class="segmented-control" role="group" aria-label="外观">
                    <button type="button" data-setting-option data-setting-name="theme" data-setting-value="auto">自动</button>
                    <button type="button" data-setting-option data-setting-name="theme" data-setting-value="light">浅色</button>
                    <button type="button" data-setting-option data-setting-name="theme" data-setting-value="dark">深色</button>
                  </div>
                </div>

                <!-- 字号设置 -->
                <div class="site-setting-row">
                  <span class="site-setting-label">字号</span>
                  <div class="segmented-control" role="group" aria-label="字号">
                    <button type="button" data-setting-option data-setting-name="fontSize" data-setting-value="s" aria-label="小字号">S</button>
                    <button type="button" data-setting-option data-setting-name="fontSize" data-setting-value="m" aria-label="中字号">M</button>
                    <button type="button" data-setting-option data-setting-name="fontSize" data-setting-value="l" aria-label="大字号">L</button>
                  </div>
                </div>

                <!-- 宽度设置 -->
                <div class="site-setting-row">
                  <span class="site-setting-label">宽度</span>
                  <div class="segmented-control" role="group" aria-label="宽度">
                    <button type="button" data-setting-option data-setting-name="contentWidth" data-setting-value="s" aria-label="窄宽度">S</button>
                    <button type="button" data-setting-option data-setting-name="contentWidth" data-setting-value="m" aria-label="中宽度">M</button>
                    <button type="button" data-setting-option data-setting-name="contentWidth" data-setting-value="l" aria-label="宽宽度">L</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>
      <script type="module" src="/_astro/SiteHeader.astro_astro_type_script_index_0_lang.Dh2xBbJQ.js"></script>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
