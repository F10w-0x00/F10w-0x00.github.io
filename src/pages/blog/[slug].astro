---
// src/pages/blog/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { processPosts } from '../../utils/posts.js';

export async function getStaticPaths() {
  const postFiles = import.meta.glob('../../../posts/*.md', { eager: true });
  const allPosts = processPosts(postFiles);

  return allPosts.map((post, idx) => {
    // 按时间顺序（allPosts是按最新在前排列）：
    // prevPost（更新的一篇）：idx > 0 ? allPosts[idx - 1]
    // nextPost（更旧的一篇）：idx < allPosts.length - 1 ? allPosts[idx + 1]
    const prevPost = idx > 0 ? allPosts[idx - 1] : null;
    const nextPost = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;

    // 同分类文章列表
    const categoryPosts = allPosts.filter(p => p.category === post.category);

    return {
      params: { slug: post.slug },
      props: {
        post,
        prevPost,
        nextPost,
        categoryPosts
      }
    };
  });
}

const { post, prevPost, nextPost, categoryPosts } = Astro.props;
const { Content } = post;
---

<BaseLayout
  title={`${post.title} | f10w-0x00`}
  description={post.description}
  pageName="blog-post"
  activeNav="blog"
>
  <div class="article-reading-shell">
    <article
      class="article-page"
      data-post-reading
      data-reading-post-slug={post.slug}
    >
      <header class="article-header has-article-category">
        <a class="article-category" href={`/blog/?category=${encodeURIComponent(post.category)}`} aria-label={`查看 ${post.category} 类型的文档`}>{post.category}</a>
        <p class="post-meta article-meta">
          <time datetime={post.dateISO}>{post.dateFormatted}</time>
          <span aria-hidden="true">/</span>
          <span>{post.words}</span>
        </p>
        <h1 id="post-title">{post.title}</h1>
        {post.description && <p>{post.description}</p>}
      </header>

      {post.cover && (
        <figure class="article-cover">
          <img
            src={post.cover}
            alt={post.title}
            width="1600"
            height="800"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}

      <div class="prose">
        <Content />
      </div>

      <!-- 本文所属分类 -->
      <section class="post-category-directory" data-post-category-directory data-current-post-id={post.slug} data-expanded="false" aria-labelledby="post-category-list-title">
        <div class="post-category-directory-header">
          <h2 id="post-category-list-title">
            本文所属分类：<a href={`/blog/?category=${encodeURIComponent(post.category)}`}>{post.category}</a><span class="post-category-directory-count">（{categoryPosts.length}）</span>
          </h2>
        </div>
        <ol id={`post-category-list-${post.slug}`} class="post-category-directory-list">
          {categoryPosts.map((cp) => (
            <li class={`post-category-directory-item ${cp.slug === post.slug ? 'is-current' : ''}`} data-post-id={cp.slug}>
              <div class="post-category-directory-item-reveal">
                <a class="post-category-directory-item-content" href={`/blog/${cp.slug}/`} aria-current={cp.slug === post.slug ? 'page' : undefined}>
                  <span class="post-category-directory-title">
                    {cp.slug === post.slug && (
                      <span class="post-category-status-icon post-category-current-icon" data-post-current-icon aria-hidden="true">
                        <svg viewBox="0 0 640 640" focusable="false"><path d="M541.9 139.5C546.4 127.7 543.6 114.3 534.7 105.4C525.8 96.5 512.4 93.6 500.6 98.2L84.6 258.2C71.9 263 63.7 275.2 64 288.7C64.3 302.2 73.1 314.1 85.9 318.3L262.7 377.2L321.6 554C325.9 566.8 337.7 575.6 351.2 575.9C364.7 576.2 376.9 568 381.8 555.4L541.8 139.4z"></path></svg>
                      </span>
                    )}
                    <span class="post-category-directory-title-text">{cp.title}</span>
                  </span>
                  <span class="post-category-directory-meta">
                    <time datetime={cp.dateISO}>{cp.dateFormatted}</time>
                    <span aria-hidden="true">/</span>
                    <span>{cp.words}</span>
                  </span>
                </a>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- 相邻文章导航 -->
      {(prevPost || nextPost) && (
        <nav class="post-adjacent-nav" aria-label="相邻文章">
          {nextPost && (
            <a class="post-adjacent-card post-adjacent-card-prev" href={`/blog/${nextPost.slug}/`} rel="prev">
              <span class="post-adjacent-label"><span aria-hidden="true">&larr;</span><span>下一篇</span></span>
              <span class="post-adjacent-title">{nextPost.title}</span>
            </a>
          )}
          {prevPost && (
            <a class="post-adjacent-card post-adjacent-card-next" href={`/blog/${prevPost.slug}/`} rel="next">
              <span class="post-adjacent-label"><span>上一篇</span><span aria-hidden="true">&rarr;</span></span>
              <span class="post-adjacent-title">{prevPost.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>
