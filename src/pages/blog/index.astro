---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="文档 | f10w-0x00"
  description="f10w-0x00 的文档列表，收录对学习、技术与日常的观察和记录。"
  pageName="blog-index"
  activeNav="blog"
>
  <section class="page-heading">
    <h1>文档</h1>
  </section>

  <div data-blog-archive>
    <section class="archive-filter" aria-label="文档列表">
      <div class="archive-filter-inner">
        <!-- 分类筛选 -->
        <div class="archive-filter-control archive-filter-control-category">
          <button type="button" class="archive-filter-button" data-blog-filter="category" data-filter-value="" aria-label="按类型筛选" aria-haspopup="listbox" aria-expanded="false">
            <span data-filter-label>所有类型</span>
            <span class="archive-filter-arrow" aria-hidden="true">
              <span class="archive-filter-arrow-line"></span>
              <span class="archive-filter-arrow-line"></span>
            </span>
          </button>
          <div class="archive-filter-menu" role="listbox" hidden>
            <button type="button" class="archive-filter-option" data-filter-option="" data-option-label="所有类型" role="option" aria-selected="true">
              <span>所有类型</span>
              <span class="archive-filter-option-count" aria-label="4 篇文章">4</span>
            </button>
            <button type="button" class="archive-filter-option" data-filter-option="学习" data-option-label="学习" role="option">
              <span>学习</span>
              <span class="archive-filter-option-count" aria-label="1 篇文章">1</span>
            </button>
            <button type="button" class="archive-filter-option" data-filter-option="UP主推荐" data-option-label="UP主推荐" role="option">
              <span>UP主推荐</span>
              <span class="archive-filter-option-count" aria-label="1 篇文章">1</span>
            </button>
            <button type="button" class="archive-filter-option" data-filter-option="日常" data-option-label="日常" role="option">
              <span>日常</span>
              <span class="archive-filter-option-count" aria-label="1 篇文章">1</span>
            </button>
            <button type="button" class="archive-filter-option" data-filter-option="博客站" data-option-label="博客站" role="option">
              <span>博客站</span>
              <span class="archive-filter-option-count" aria-label="1 篇文章">1</span>
            </button>
          </div>
        </div>

        <!-- 年份筛选 -->
        <div class="archive-filter-control archive-filter-control-year">
          <button type="button" class="archive-filter-button" data-blog-filter="year" data-filter-value="" aria-label="按年份筛选" aria-haspopup="listbox" aria-expanded="false">
            <span data-filter-label>全部年份</span>
            <span class="archive-filter-arrow" aria-hidden="true">
              <span class="archive-filter-arrow-line"></span>
              <span class="archive-filter-arrow-line"></span>
            </span>
          </button>
          <div class="archive-filter-menu" role="listbox" hidden>
            <button type="button" class="archive-filter-option" data-filter-option="" data-option-label="全部年份" role="option" aria-selected="true">
              全部年份
            </button>
            <button type="button" class="archive-filter-option" data-filter-option="2026" data-option-label="2026 年" role="option">
              2026 年
            </button>
          </div>
        </div>

        <!-- 排序切换 -->
        <button type="button" class="archive-sort-button" data-blog-sort="desc" data-sort-label-asc="从旧到新" data-sort-label-desc="从新到旧" aria-label="切换文档排序">
          <span class="archive-sort-triangle" aria-hidden="true"></span>
          <span data-sort-label>从新到旧</span>
        </button>
      </div>
    </section>

    <!-- 文档列表 -->
    <section class="post-list" aria-label="文档列表" data-blog-archive-posts data-blog-comment-counts data-post-reading-state data-comments-api-base="/api/comments" data-reading-api-base="/api/comments" data-visitor-enabled="true">
      <!-- 文章 1: Obsidian -->
      <div data-blog-post data-category="学习" data-year="2026" data-date="1790812800000">
        <article class="post-card" data-reading-post-id="post-ae8ffbc6-9bdd-4f19-a6d2-de2b367032ac" data-reading-post-slug="2026-10-01-how-i-use-obsidian">
          <a href="/blog/2026-10-01-how-i-use-obsidian/" class="post-card-link has-cover">
            <div class="post-card-body">
              <h2>
                <span class="post-card-visited-icon post-visited-icon" data-post-visited-icon aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false"><path d="m3.5 11.5 5.5 5.5L20 6"></path></svg>
                </span>
                <span class="post-card-title-text">我是怎么使用 Obsidian 的</span>
              </h2>
              <p>Obsidian 的哲学和缺陷，双链笔记与本地知识库构建</p>
              <div class="post-card-footer">
                <p class="post-meta post-card-meta">
                  <time datetime="2026-10-01T00:00:00.000Z">10月1日</time>
                  <span aria-hidden="true">/</span>
                  <span>2994 字</span>
                </p>
              </div>
            </div>
            <div class="post-card-cover" aria-hidden="true">
              <img src="/_astro/814A9B04-173E-4FFE-AD5C-2A06884329B5-thumb.C1EMAMs5.avif" alt="" width="640" height="320" loading="lazy" decoding="async">
            </div>
          </a>
        </article>
      </div>

      <!-- 文章 2: UP主推荐 -->
      <div data-blog-post data-category="UP主推荐" data-year="2026" data-date="1784937600000">
        <article class="post-card" data-reading-post-id="post-b6811d8c-29c0-4397-bc2d-5516f0bea035" data-reading-post-slug="2026-07-25-recommended-up-creators-im-following-part-3">
          <a href="/blog/2026-07-25-recommended-up-creators-im-following-part-3/" class="post-card-link has-cover">
            <div class="post-card-body">
              <h2>
                <span class="post-card-visited-icon post-visited-icon" data-post-visited-icon aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false"><path d="m3.5 11.5 5.5 5.5L20 6"></path></svg>
                </span>
                <span class="post-card-title-text">推荐几位我在看的 UP（三）</span>
              </h2>
              <p>无关茉莉星、董晨宇、徐师傅、技术爬爬虾</p>
              <div class="post-card-footer">
                <p class="post-meta post-card-meta">
                  <time datetime="2026-07-25T00:00:00.000Z">7月25日</time>
                  <span aria-hidden="true">/</span>
                  <span>1860 字</span>
                </p>
              </div>
            </div>
            <div class="post-card-cover" aria-hidden="true">
              <img src="/_astro/wp8667993-bilibili-wallpapers%201-thumb.RWTKrlzg.avif" alt="" width="640" height="320" loading="lazy" decoding="async">
            </div>
          </a>
        </article>
      </div>

      <!-- 文章 3: 拔智齿经历 -->
      <div data-blog-post data-category="日常" data-year="2026" data-date="1784505600000">
        <article class="post-card" data-reading-post-id="post-9638114f-8e1f-4b38-9106-faefa88a01ad" data-reading-post-slug="2026-07-20-my-wisdom-tooth-extraction-experience">
          <a href="/blog/2026-07-20-my-wisdom-tooth-extraction-experience/" class="post-card-link has-cover">
            <div class="post-card-body">
              <h2>
                <span class="post-card-visited-icon post-visited-icon" data-post-visited-icon aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false"><path d="m3.5 11.5 5.5 5.5L20 6"></path></svg>
                </span>
                <span class="post-card-title-text">拔智齿的经历</span>
              </h2>
              <p>拔智齿的全过程记录：拍片、付费、麻醉、手术，以及术后一周的恢复经验</p>
              <div class="post-card-footer">
                <p class="post-meta post-card-meta">
                  <time datetime="2026-07-20T00:00:00.000Z">7月20日</time>
                  <span aria-hidden="true">/</span>
                  <span>3240 字</span>
                </p>
              </div>
            </div>
            <div class="post-card-cover" aria-hidden="true">
              <img src="/_astro/ChatGPT%20Image%20Jul%2020_%202026_%2005_29_43%20PM-thumb.DmWba74d.avif" alt="" width="640" height="320" loading="lazy" decoding="async">
            </div>
          </a>
        </article>
      </div>

      <!-- 文章 4: 视觉与交互设计 -->
      <div data-blog-post data-category="博客站" data-year="2026" data-date="1781049600000">
        <article class="post-card" data-reading-post-id="post-32298018-ffe2-468f-99af-804a8ac98c0e" data-reading-post-slug="2026-06-10-visual-and-interaction-design-of-this-blog-site">
          <a href="/blog/2026-06-10-visual-and-interaction-design-of-this-blog-site/" class="post-card-link has-cover">
            <div class="post-card-body">
              <h2>
                <span class="post-card-visited-icon post-visited-icon" data-post-visited-icon aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false"><path d="m3.5 11.5 5.5 5.5L20 6"></path></svg>
                </span>
                <span class="post-card-title-text">本博客站的视觉和交互设计</span>
              </h2>
              <p>对博客站的设计思路的记录，也是对参与博客站建设的人的致谢</p>
              <div class="post-card-footer">
                <p class="post-meta post-card-meta">
                  <time datetime="2026-06-10T00:00:00.000Z">6月10日</time>
                  <span aria-hidden="true">/</span>
                  <span>3659 字</span>
                </p>
              </div>
            </div>
            <div class="post-card-cover" aria-hidden="true">
              <img src="/_astro/3C00CB1E-3C8A-48A9-9FE2-BE12F01B7E87-thumb.CigA-ns2.avif" alt="" width="640" height="320" loading="lazy" decoding="async">
            </div>
          </a>
        </article>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      function initArchive(archiveEl) {
        if (!archiveEl || archiveEl.dataset.archiveInit === 'true') return;
        archiveEl.dataset.archiveInit = 'true';

        const filterButtons = Array.from(archiveEl.querySelectorAll('[data-blog-filter]'));
        const sortButton = archiveEl.querySelector('[data-blog-sort]');
        const postsContainer = archiveEl.querySelector('[data-blog-archive-posts]');
        const postItems = Array.from(archiveEl.querySelectorAll('[data-blog-post]')).map((item, index) => ({
          item,
          index,
          date: Number(item.dataset.date || 0),
          category: item.dataset.category || '',
          year: item.dataset.year || ''
        }));
        const emptyEl = archiveEl.querySelector('[data-filter-empty]');

        function closeAllMenus(exceptBtn) {
          filterButtons.forEach(btn => {
            if (btn !== exceptBtn) {
              btn.setAttribute('aria-expanded', 'false');
              const menu = btn.closest('.archive-filter-control')?.querySelector('.archive-filter-menu');
              if (menu) menu.setAttribute('hidden', '');
            }
          });
        }

        function updateList() {
          const categoryFilter = archiveEl.querySelector('[data-blog-filter="category"]')?.dataset.filterValue || '';
          const yearFilter = archiveEl.querySelector('[data-blog-filter="year"]')?.dataset.filterValue || '';
          const sortOrder = sortButton?.dataset.blogSort === 'asc' ? 'asc' : 'desc';

          const sorted = [...postItems].sort((a, b) => {
            return (sortOrder === 'asc' ? a.date - b.date : b.date - a.date) || a.index - b.index;
          });

          let visibleCount = 0;
          sorted.forEach(({ item, category, year }) => {
            const matchesCat = !categoryFilter || category === categoryFilter;
            const matchesYear = !yearFilter || year === yearFilter;
            const isVisible = matchesCat && matchesYear;
            item.hidden = !isVisible;
            if (isVisible) {
              visibleCount++;
            }
            if (postsContainer) {
              postsContainer.appendChild(item);
            }
          });

          if (emptyEl) {
            emptyEl.hidden = visibleCount > 0;
          }
        }

        function syncUrlParams() {
          const params = new URLSearchParams(window.location.search);
          ['category', 'year'].forEach(name => {
            const val = archiveEl.querySelector(`[data-blog-filter="${name}"]`)?.dataset.filterValue || '';
            if (val) {
              params.set(name, val);
            } else {
              params.delete(name);
            }
          });
          const query = params.toString();
          const newUrl = `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`;
          window.history.replaceState(null, '', newUrl);
        }

        function selectOption(btn, optionEl) {
          const control = btn.closest('.archive-filter-control');
          const label = btn.querySelector('[data-filter-label]');
          const options = Array.from(control?.querySelectorAll('[data-filter-option]') || []);
          const val = optionEl.dataset.filterOption || '';
          btn.dataset.filterValue = val;
          if (label) {
            label.textContent = optionEl.dataset.optionLabel || optionEl.textContent.trim() || '';
          }
          options.forEach(opt => {
            opt.setAttribute('aria-selected', String(opt === optionEl));
          });
        }

        // 1. 初始化时读取 URL 参数
        const currentParams = new URLSearchParams(window.location.search);
        filterButtons.forEach(btn => {
          const filterName = btn.dataset.blogFilter;
          const urlVal = filterName ? currentParams.get(filterName) : null;
          if (urlVal) {
            const control = btn.closest('.archive-filter-control');
            const matchingOpt = control?.querySelector(`[data-filter-option="${CSS.escape(urlVal)}"]`);
            if (matchingOpt) {
              selectOption(btn, matchingOpt);
            }
          }
        });

        // 2. 绑定筛选下拉菜单点击展开/收起
        filterButtons.forEach(btn => {
          const control = btn.closest('.archive-filter-control');
          const menu = control?.querySelector('.archive-filter-menu');
          const options = Array.from(control?.querySelectorAll('[data-filter-option]') || []);

          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = btn.getAttribute('aria-expanded') === 'true';
            closeAllMenus(btn);
            btn.setAttribute('aria-expanded', String(!isOpen));
            if (menu) {
              if (isOpen) {
                menu.setAttribute('hidden', '');
              } else {
                menu.removeAttribute('hidden');
              }
            }
          });

          options.forEach(opt => {
            opt.addEventListener('click', (e) => {
              e.stopPropagation();
              selectOption(btn, opt);
              closeAllMenus();
              syncUrlParams();
              updateList();
            });
          });
        });

        // 3. 点击外部或按 ESC 关闭所有下拉菜单
        document.addEventListener('click', (e) => {
          if (!archiveEl.contains(e.target)) {
            closeAllMenus();
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeAllMenus();
        });

        // 4. 排序按钮交互（60° 三角形旋转与正倒序切换）
        if (sortButton) {
          sortButton.addEventListener('click', () => {
            const currentSort = sortButton.dataset.blogSort === 'asc' ? 'desc' : 'asc';
            const labelEl = sortButton.querySelector('[data-sort-label]');
            const prevRotation = Number(sortButton.dataset.sortRotation || 180);
            const nextRotation = prevRotation + 60;

            sortButton.dataset.blogSort = currentSort;
            sortButton.dataset.sortRotation = String(nextRotation);
            sortButton.style.setProperty('--sort-triangle-rotation', `${nextRotation}deg`);

            if (labelEl) {
              labelEl.textContent = currentSort === 'asc'
                ? (sortButton.dataset.sortLabelAsc || '从旧到新')
                : (sortButton.dataset.sortLabelDesc || '从新到旧');
            }

            updateList();
          });
        }

        // 5. 初始渲染一次，确保 URL 过滤与排序生效
        updateList();
      }

      function boot() {
        document.querySelectorAll('[data-blog-archive]').forEach(initArchive);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot, { once: true });
      } else {
        boot();
      }
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</BaseLayout>
