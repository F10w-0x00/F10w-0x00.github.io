---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { processPosts } from '../utils/posts.js';

const postFiles = import.meta.glob('../../posts/*.md', { eager: true });
const allPosts = processPosts(postFiles);
const recentPosts = allPosts.slice(0, 4);
---

<BaseLayout
  title="f10w-0x00"
  description="f10w-0x00 的个人博客与数字空间，记录学习、技术与日常的观察。"
  pageName="home"
  activeNav="home"
>
  <section class="home-section home-recent-posts" aria-labelledby="recent-posts-title" style="padding-top: clamp(48px, 6vw, 72px);">
    <div class="home-section-header">
      <h2 id="recent-posts-title">Recent Posts</h2>
      <a class="text-button" href="/blog/">Read All →</a>
    </div>
    <div class="home-post-grid">
      {recentPosts.map((post) => (
        <article class="home-post-card">
          <a href={`/blog/${post.slug}/`} class="home-post-card-link">
            {post.cover && (
              <div class="home-post-cover">
                <img src={post.cover} alt={post.title} width="640" height="320" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="home-post-body">
              <h3>{post.title}</h3>
              {post.description && <p>{post.description}</p>}
              <p class="post-meta home-post-meta">
                <time datetime={post.dateISO}>{post.dateFormatted}</time>
                <span aria-hidden="true">/</span>
                <span>{post.words}</span>
              </p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
